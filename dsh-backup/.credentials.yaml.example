# File mẫu cấu hình API key / Token cho DeepSeek Harness (DSH)
# Copy file này thành ~/.dsh/.credentials.yaml hoặc đặt biến môi trường trong ~/.bashrc / ~/.zshrc
#
# CÁC BIẾN MÔI TRƯỜNG THƯỜNG DÙNG (Khuyến nghị thêm vào ~/.bashrc):
# export DEEPSEEK_API_KEY="sk-..."
# export OR_API_KEY="sk-..."       # OmniRoute gateway
# export CGW_API_KEY="sk-..."      # ChatGPT Web bridge
# export NR_API_KEY="sk-..."       # 9Router gateway
# export B_AI_API_KEY="sk-..."
#
